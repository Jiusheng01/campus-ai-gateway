HTTP_ADDR=:8080
DATABASE_URL=postgres://campus:campus@localhost:5432/campus_gateway?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
API_KEY_HMAC_SECRET=replace-with-a-long-random-secret
THINKWATCH_URL=http://localhost:8788
THINKWATCH_GATEWAY_KEY=
THINKWATCH_CONFIG_PATH=

# --- Admin authentication ---------------------------------------------------
# Default mode: local administrator accounts with a password. The first run
# creates the super administrator through the Admin UI.
ADMIN_AUTH_MODE=session

# Dedicated key for administrator session cryptography (access-token signing and
# refresh rotation). It must NOT be the same value as API_KEY_HMAC_SECRET, so a
# compromise of one security domain cannot reach the other.
#
# Generate with:  openssl rand -base64 48
# Minimum 32 bytes. When it is left empty the gateway derives a
# domain-separated key from API_KEY_HMAC_SECRET and logs a warning — that
# fallback exists only so local development works with no extra setup.
ADMIN_SESSION_SECRET=

# Session lifetimes.
ADMIN_ACCESS_TTL=15m
ADMIN_REFRESH_TTL=720h

# How long a just-rotated refresh token is still accepted as a benign
# concurrent refresh (two browser tabs racing). Reuse after this window is
# treated as replay and revokes every session of the account.
#
# The default of 5s covers genuinely racing refreshes and nothing more: a
# longer window only extends how long a *stolen superseded* token keeps being
# accepted. It does not protect a stolen current token, and it does not
# replace HttpOnly, Secure, SameSite, rotation, replay detection or
# session-family revocation. Deployments behind unusually slow proxies may
# raise it (10s); never set 0 — ordinary races would be treated as replay.
ADMIN_REFRESH_REPLAY_GRACE=5s

# Login throttling. The per-username budget is derived as 4x this value, which
# stops a distributed campaign against one account from many source addresses.
ADMIN_LOGIN_MAX_ATTEMPTS=8
ADMIN_LOGIN_WINDOW=15m

# First-run setup is restricted to the machine itself unless this is false.
ADMIN_SETUP_LOCAL_ONLY=true

# --- Public account registration -------------------------------------------
# Off by default. Anyone who can reach the login page may create an account when
# this is explicitly switched on; such an account is always created with the
# single role "member"; administrator roles can only be granted later by a super
# administrator. While the system has no super administrator yet, registration
# is refused so that the first-run setup flow stays the only way in.
#
# The default is false because the confirmed production entry point is campus
# SSO and a member has no data-plane capability yet. Turn it on only for a
# controlled trial or a deployment that genuinely wants local password
# accounts; the account system and the admin roles are unaffected either way.
PUBLIC_REGISTRATION_ENABLED=false

# Registration throttling is per source address and counts every attempt,
# including the ones that fail on a duplicate username — otherwise the endpoint
# could be used to probe which usernames exist. Unlike login throttling this
# fails closed: if the counter cannot be consulted, registration is refused
# rather than left unlimited.
PUBLIC_REGISTER_MAX_ATTEMPTS=5
PUBLIC_REGISTER_WINDOW=1h

# Add Secure to the refresh cookie. Requires HTTPS, so leave false for plain
# HTTP development.
ADMIN_COOKIE_SECURE=false

# Proxies whose X-Forwarded-For we trust. Anything not listed here is ignored,
# which is what stops a remote visitor from being mistaken for a local one.
TRUSTED_PROXY_CIDRS=

# Unattended first-run bootstrap (optional). Leave empty for the interactive
# /admin/setup flow.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Legacy / emergency admin modes -----------------------------------------
# ADMIN_AUTH_MODE=token keeps the break-glass ADMIN_TOKEN. The Admin UI does not
# offer a login form in this mode.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# ADMIN_AUTH_MODE=trusted-header expects an authenticating reverse proxy in
# front of the gateway.
ADMIN_PROXY_SECRET=
ADMIN_USER_HEADER=X-Forwarded-User
ADMIN_ROLES_HEADER=X-Forwarded-Groups

# --- Provider credentials ---------------------------------------------------
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=

TWCORE_EXE=
